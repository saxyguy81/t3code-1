diff --git a/apps/server/src/orchestration-v2/HubHold.test.ts b/apps/server/src/orchestration-v2/HubHold.test.ts
new file mode 100644
index 000000000..70a246490
--- /dev/null
+++ b/apps/server/src/orchestration-v2/HubHold.test.ts
@@ -0,0 +1,169 @@
+import * as NodeServices from "@effect/platform-node/NodeServices";
+import { assert, it } from "@effect/vitest";
+import { CommandId, RunId, ThreadId } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as SqlClient from "effect/sql/SqlClient";
+
+import * as SqlitePersistence from "../persistence/Sqlite.ts";
+import * as ServerSettings from "../serverSettings.ts";
+import * as EffectOutbox from "./EffectOutbox.ts";
+import * as HubHold from "./HubHold.ts";
+
+const layerTest = (settings: Parameters<typeof ServerSettings.layerTest>[0] = {}) =>
+  Layer.fresh(
+    HubHold.layer.pipe(
+      Layer.provideMerge(EffectOutbox.layer),
+      Layer.provideMerge(SqlitePersistence.layerMemory),
+      Layer.provide(ServerSettings.layerTest(settings)),
+      Layer.provide(NodeServices.layer),
+    ),
+  );
+
+const threadId = ThreadId.make("thread:hub-hold");
+const operator = { actor: "operator (session test)", reason: "maintenance window" };
+
+const enqueueStart = (suffix: string) =>
+  Effect.gen(function* () {
+    const outbox = yield* EffectOutbox.EffectOutboxV2;
+    const effectId = `effect:hub-hold:${suffix}`;
+    yield* outbox.enqueue([
+      {
+        id: effectId,
+        commandId: CommandId.make(`command:hub-hold:${suffix}`),
+        threadId: ThreadId.make(`${threadId}:${suffix}`),
+        request: { type: "provider-turn.start", runId: RunId.make(`run:hub-hold:${suffix}`) },
+      },
+    ]);
+    return effectId;
+  });
+
+it.effect("keeps held provider effects pending and releases each once on clear", () =>
+  Effect.gen(function* () {
+    const hold = yield* HubHold.HubHoldV2;
+    const outbox = yield* EffectOutbox.EffectOutboxV2;
+    yield* hold.set(operator);
+    const effectId = yield* enqueueStart("held");
+    yield* outbox.enqueue([
+      {
+        id: "effect:hub-hold:cleanup",
+        commandId: CommandId.make("command:hub-hold:cleanup"),
+        threadId: ThreadId.make("thread:hub-hold:cleanup"),
+        request: { type: "terminal.cleanup" },
+      },
+    ]);
+
+    // Work that does not reach a provider still runs under the hold.
+    const cleanup = yield* outbox.claimNext({ workerId: "w", leaseDurationMs: 30_000 });
+    assert.equal(Option.getOrThrow(cleanup).request.type, "terminal.cleanup");
+    yield* outbox.succeed({ effectId: "effect:hub-hold:cleanup", workerId: "w" });
+    assert.isTrue(
+      Option.isNone(yield* outbox.claimNext({ workerId: "w", leaseDurationMs: 30_000 })),
+    );
+    // A held row must not make the worker spin on a past deadline.
+    assert.isTrue(Option.isNone(yield* outbox.nextClaimableAt));
+    assert.deepEqual((yield* hold.counts).heldEffects, 1);
+
+    yield* hold.clear({ ...operator, reason: "window over" });
+    const claimed = yield* outbox.claimNext({ workerId: "w", leaseDurationMs: 30_000 });
+    assert.equal(Option.getOrThrow(claimed).id, effectId);
+    assert.equal(Option.getOrThrow(claimed).attemptCount, 1);
+    yield* outbox.succeed({ effectId, workerId: "w" });
+    assert.isTrue(
+      Option.isNone(yield* outbox.claimNext({ workerId: "w", leaseDurationMs: 30_000 })),
+    );
+  }).pipe(Effect.provide(layerTest())),
+);
+
+it.effect("returns a claim that raced the hold to pending without spending an attempt", () =>
+  Effect.gen(function* () {
+    const hold = yield* HubHold.HubHoldV2;
+    const outbox = yield* EffectOutbox.EffectOutboxV2;
+    const effectId = yield* enqueueStart("race");
+    const claimed = yield* outbox.claimNext({ workerId: "w", leaseDurationMs: 30_000 });
+    assert.isTrue(Option.isSome(claimed));
+    // Without a hold the claim is kept.
+    assert.isFalse(yield* outbox.releaseHeldClaim({ effectId, workerId: "w" }));
+
+    yield* hold.set(operator);
+    assert.isFalse(yield* outbox.releaseHeldClaim({ effectId, workerId: "other" }));
+    assert.isTrue(yield* outbox.releaseHeldClaim({ effectId, workerId: "w" }));
+    const row = Option.getOrThrow(yield* outbox.get(effectId));
+    assert.equal(row.status, "pending");
+    assert.equal(row.attemptCount, 0);
+    assert.isTrue(yield* outbox.hasUnsentTurnStart(RunId.make("run:hub-hold:race")));
+  }).pipe(Effect.provide(layerTest())),
+);
+
+it.effect("reports a start as unsent only before its first claim", () =>
+  Effect.gen(function* () {
+    const outbox = yield* EffectOutbox.EffectOutboxV2;
+    const runId = RunId.make("run:hub-hold:unsent");
+    yield* enqueueStart("unsent");
+    assert.isTrue(yield* outbox.hasUnsentTurnStart(runId));
+    yield* outbox.claimNext({ workerId: "w", leaseDurationMs: 30_000 });
+    assert.isFalse(yield* outbox.hasUnsentTurnStart(runId));
+    // A start that failed once may have reached the provider.
+    yield* outbox.retry({
+      effectId: "effect:hub-hold:unsent",
+      workerId: "w",
+      error: "boom",
+      delayMs: 0,
+    });
+    assert.isFalse(yield* outbox.hasUnsentTurnStart(runId));
+  }).pipe(Effect.provide(layerTest())),
+);
+
+it.effect("records who, when and why for every set and clear, and survives a reread", () =>
+  Effect.gen(function* () {
+    const hold = yield* HubHold.HubHoldV2;
+    const sql = yield* SqlClient.SqlClient;
+    assert.deepEqual(yield* hold.read, {
+      held: false,
+      actor: null,
+      reason: null,
+      changedAt: null,
+    });
+    const set = yield* hold.set(operator);
+    assert.isTrue(set.held);
+    assert.equal(set.actor, operator.actor);
+    assert.equal(set.reason, operator.reason);
+    assert.isString(set.changedAt);
+    // Setting again keeps the hold and records the request.
+    yield* hold.set({ ...operator, reason: "still held" });
+    assert.isTrue(yield* hold.isHeld);
+    const cleared = yield* hold.clear({ actor: "other (session b)", reason: "done" });
+    assert.isFalse(cleared.held);
+    assert.equal(cleared.actor, "other (session b)");
+    const history = yield* sql<{ readonly action: string; readonly reason: string }>`
+      SELECT action, reason FROM orchestration_v2_hub_hold_history ORDER BY sequence
+    `;
+    assert.deepEqual(
+      history.map((row) => [row.action, row.reason]),
+      [
+        ["set", "maintenance window"],
+        ["set", "still held"],
+        ["clear", "done"],
+      ],
+    );
+  }).pipe(Effect.provide(layerTest())),
+);
+
+it.effect("reads back continuation settings and runtime identity in the inventory", () =>
+  Effect.gen(function* () {
+    const hold = yield* HubHold.HubHoldV2;
+    const inventory = yield* hold.inventory;
+    assert.isFalse(inventory.continueThreadsAfterServerUpdate.global);
+    assert.deepEqual(inventory.continueThreadsAfterServerUpdate.projectOverridesEnabled, []);
+    assert.isString(inventory.runtime.version);
+    assert.deepEqual(inventory.counts, {
+      queued: 0,
+      held: 0,
+      inFlight: 0,
+      outboxPending: 0,
+      outboxRunning: 0,
+      heldEffects: 0,
+    });
+  }).pipe(Effect.provide(layerTest({ continueThreadsAfterServerUpdate: false }))),
+);
