From fb36f05552206ec2a189b2da572adc394122e48d Mon Sep 17 00:00:00 2001
From: "Scott Hanan (t2 executor)" <t3exec@t2.tailc9b568.ts.net>
Date: Fri, 16 Oct 2026 07:11:35 -0700
Subject: [PATCH 17/17] fix(server): runtime identity hashes the single
 executable when running as one (#303)

Under the published t3 single executable, process.argv[1] is not a .mjs entry,
so bundleSha256 read null. Hash process.execPath instead when node:sea reports
a SEA. Not part of release build 2.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 apps/server/src/orchestration-v2/RuntimeIdentity.ts | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/apps/server/src/orchestration-v2/RuntimeIdentity.ts b/apps/server/src/orchestration-v2/RuntimeIdentity.ts
index 140a568cd..0457b47f6 100644
--- a/apps/server/src/orchestration-v2/RuntimeIdentity.ts
+++ b/apps/server/src/orchestration-v2/RuntimeIdentity.ts
@@ -1,3 +1,6 @@
+// @effect-diagnostics nodeBuiltinImport:off
+import * as NodeSea from "node:sea";
+
 import type { HubDispatchRuntimeIdentity } from "@t3tools/contracts";
 import * as Effect from "effect/Effect";
 import * as Hex from "effect/encoding/Hex";
@@ -9,6 +12,8 @@ import packageJson from "../../package.json" with { type: "json" };
 /**
  * Identity of the bundle this process loaded, captured once at boot. Hashing
  * later would report replaced staging files instead of the running bytes.
+ * A single executable (the published `t3` binary) carries its bundle inside,
+ * so the executable itself is hashed; otherwise the `.mjs` entry is.
  */
 export const captureRuntimeIdentity: Effect.Effect<
   HubDispatchRuntimeIdentity,
@@ -17,8 +22,8 @@ export const captureRuntimeIdentity: Effect.Effect<
 > = Effect.gen(function* () {
   const fs = yield* FileSystem.FileSystem;
   const path = yield* Path.Path;
-  const entry = process.argv[1];
-  if (entry === undefined || path.extname(entry) !== ".mjs") {
+  const entry = NodeSea.isSea() ? process.execPath : process.argv[1];
+  if (entry === undefined || (!NodeSea.isSea() && path.extname(entry) !== ".mjs")) {
     return { version: packageJson.version, entryPath: null, bundleSha256: null };
   }
   const entryPath = yield* fs.realPath(entry);
-- 
