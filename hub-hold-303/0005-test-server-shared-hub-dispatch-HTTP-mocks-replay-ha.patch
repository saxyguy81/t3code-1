+++ b/apps/server/src/orchestration-v2/testkit/HubDispatchHttpMocks.ts
@@ -0,0 +1,19 @@
+import * as Layer from "effect/Layer";
+
+import * as ServerConfig from "../../config.ts";
+import * as ServerRuntimeStartup from "../../serverRuntimeStartup.ts";
+import * as ServerSettings from "../../serverSettings.ts";
+import * as HubHold from "../HubHold.ts";
+import * as ThreadLaunchService from "../ThreadLaunchService.ts";
+
+/**
+ * Services the orchestration HTTP group captures for the hub hold and the
+ * 0.0.x dispatch routes. For tests whose requests never reach those routes.
+ */
+export const layerHubDispatchHttpMocks = Layer.mergeAll(
+  Layer.mock(HubHold.HubHoldV2)({}),
+  Layer.mock(ServerRuntimeStartup.ServerRuntimeStartup)({}),
+  Layer.mock(ThreadLaunchService.ThreadLaunchService)({}),
+  Layer.mock(ServerSettings.ServerSettingsService)({}),
+  ServerConfig.layerTest(process.cwd(), { prefix: "t3-hub-dispatch-http-test-" }),
+);
