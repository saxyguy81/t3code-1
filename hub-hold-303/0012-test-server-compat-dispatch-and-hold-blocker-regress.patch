+it.effect("lets an interrupt behind held input on the same thread run under the hold", () =>
+  Effect.gen(function* () {
+    const hold = yield* HubHold.HubHoldV2;
+    const outbox = yield* EffectOutbox.EffectOutboxV2;
+    const busy = ThreadId.make("thread:hub-hold:busy");
+    const turn = {
+      providerSessionId: ProviderSessionId.make("session:hub-hold"),
+      providerThreadId: ProviderThreadId.make("provider-thread:hub-hold"),
+      providerTurnId: ProviderTurnId.make("provider-turn:hub-hold"),
+    };
+    yield* hold.set(operator);
+    yield* outbox.enqueue([
+      {
+        id: "effect:hub-hold:steer",
+        commandId: CommandId.make("command:hub-hold:steer"),
+        threadId: busy,
+        request: { type: "provider-turn.steer", ...turn, messageId: MessageId.make("message:steer") },
+      },
+    ]);
+    yield* outbox.enqueue([
+      {
+        id: "effect:hub-hold:interrupt",
+        commandId: CommandId.make("command:hub-hold:interrupt"),
+        threadId: busy,
+        request: { type: "provider-turn.interrupt", ...turn },
+      },
+    ]);
+    // Stop must not wait for the held steer queued ahead of it.
+    const interrupt = yield* outbox.claimNext({ workerId: "w", leaseDurationMs: 30_000 });
+    assert.equal(Option.getOrThrow(interrupt).id, "effect:hub-hold:interrupt");
+    yield* outbox.succeed({ effectId: "effect:hub-hold:interrupt", workerId: "w" });
+    assert.isTrue(
+      Option.isNone(yield* outbox.claimNext({ workerId: "w", leaseDurationMs: 30_000 })),
+    );
+    // The steer is still held, then runs once after the clear.
+    yield* hold.clear({ ...operator, reason: "window over" });
+    const steer = yield* outbox.claimNext({ workerId: "w", leaseDurationMs: 30_000 });
+    assert.equal(Option.getOrThrow(steer).id, "effect:hub-hold:steer");
+  }).pipe(Effect.provide(layerTest())),
+);
+
+it.effect("keeps per-thread order behind pending input when no hold is set", () =>
+  Effect.gen(function* () {
+    const outbox = yield* EffectOutbox.EffectOutboxV2;
+    const busy = ThreadId.make("thread:hub-hold:fifo");
+    const turn = {
+      providerSessionId: ProviderSessionId.make("session:hub-hold:fifo"),
+      providerThreadId: ProviderThreadId.make("provider-thread:hub-hold:fifo"),
+      providerTurnId: ProviderTurnId.make("provider-turn:hub-hold:fifo"),
+    };
+    yield* outbox.enqueue([
+      {
+        id: "effect:hub-hold:fifo-steer",
+        commandId: CommandId.make("command:hub-hold:fifo-steer"),
+        threadId: busy,
+        request: { type: "provider-turn.steer", ...turn, messageId: MessageId.make("message:fifo") },
+      },
+    ]);
+    yield* outbox.enqueue([
+      {
+        id: "effect:hub-hold:fifo-interrupt",
+        commandId: CommandId.make("command:hub-hold:fifo-interrupt"),
+        threadId: busy,
+        request: { type: "provider-turn.interrupt", ...turn },
+      },
+    ]);
+    const first = yield* outbox.claimNext({ workerId: "w", leaseDurationMs: 30_000 });
+    assert.equal(Option.getOrThrow(first).id, "effect:hub-hold:fifo-steer");
+  }).pipe(Effect.provide(layerTest())),
+);
