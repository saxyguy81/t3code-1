diff --git a/apps/server/src/orchestration-v2/HubHold.ts b/apps/server/src/orchestration-v2/HubHold.ts
new file mode 100644
index 000000000..1478c6c12
--- /dev/null
+++ b/apps/server/src/orchestration-v2/HubHold.ts
@@ -0,0 +1,189 @@
+import type {
+  HubDispatchHoldState,
+  HubDispatchInventory,
+  HubDispatchInventoryCounts,
+  ProjectId,
+} from "@t3tools/contracts";
+import { resolveProjectSettings } from "@t3tools/shared/projectSettings";
+import * as Context from "effect/Context";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import type * as FileSystem from "effect/FileSystem";
+import * as Layer from "effect/Layer";
+import type * as Path from "effect/Path";
+import * as Schema from "effect/Schema";
+import * as SqlClient from "effect/sql/SqlClient";
+
+import * as ServerSettings from "../serverSettings.ts";
+import * as EffectOutbox from "./EffectOutbox.ts";
+import { captureRuntimeIdentity } from "./RuntimeIdentity.ts";
+
+export const readHubHeld = (sql: SqlClient.SqlClient) =>
+  sql<{ readonly held: number }>`
+    SELECT held FROM orchestration_v2_hub_hold WHERE hold_id = 1
+  `.pipe(Effect.map((rows) => rows[0]?.held === 1));
+
+export class HubHoldError extends Schema.TaggedError<HubHoldError>()("HubHoldError", {
+  operation: Schema.String,
+  cause: Schema.optional(Schema.Defect()),
+}) {
+  override get message(): string {
+    return `Hub dispatch hold ${this.operation} failed.`;
+  }
+}
+
+export interface HubHoldV2Shape {
+  readonly read: Effect.Effect<HubDispatchHoldState, HubHoldError>;
+  readonly isHeld: Effect.Effect<boolean, HubHoldError>;
+  /** Idempotent: setting an active hold records the request and keeps the hold. */
+  readonly set: (input: {
+    readonly actor: string;
+    readonly reason: string;
+  }) => Effect.Effect<HubDispatchHoldState, HubHoldError>;
+  readonly clear: (input: {
+    readonly actor: string;
+    readonly reason: string;
+  }) => Effect.Effect<HubDispatchHoldState, HubHoldError>;
+  readonly counts: Effect.Effect<HubDispatchInventoryCounts, HubHoldError>;
+  /** Read-only: running bundle identity, hold, counts and continuation readback. */
+  readonly inventory: Effect.Effect<HubDispatchInventory, HubHoldError>;
+}
+
+export class HubHoldV2 extends Context.Service<HubHoldV2, HubHoldV2Shape>()(
+  "t3/orchestration-v2/HubHold/HubHoldV2",
+) {}
+
+type HoldRow = {
+  readonly held: number;
+  readonly actor: string;
+  readonly reason: string;
+  readonly changed_at: string;
+};
+
+const toState = (row: HoldRow | undefined): HubDispatchHoldState =>
+  row === undefined
+    ? { held: false, actor: null, reason: null, changedAt: null }
+    : { held: row.held === 1, actor: row.actor, reason: row.reason, changedAt: row.changed_at };
+
+export const layer: Layer.Layer<
+  HubHoldV2,
+  never,
+  | SqlClient.SqlClient
+  | EffectOutbox.EffectOutboxV2
+  | ServerSettings.ServerSettingsService
+  | FileSystem.FileSystem
+  | Path.Path
+> = Layer.effect(
+    HubHoldV2,
+    Effect.gen(function* () {
+      const sql = yield* SqlClient.SqlClient;
+      const outbox = yield* EffectOutbox.EffectOutboxV2;
+      const settings = yield* ServerSettings.ServerSettingsService;
+      const runtime = yield* captureRuntimeIdentity;
+
+      const readRow = sql<HoldRow>`
+        SELECT held, actor, reason, changed_at FROM orchestration_v2_hub_hold WHERE hold_id = 1
+      `.pipe(Effect.map((rows) => toState(rows[0])));
+
+      const write = (action: "set" | "clear", input: { actor: string; reason: string }) =>
+        sql
+          .withTransaction(
+            Effect.gen(function* () {
+              const now = DateTime.formatIso(yield* DateTime.now);
+              const held = action === "set" ? 1 : 0;
+              yield* sql`
+                INSERT INTO orchestration_v2_hub_hold (hold_id, held, actor, reason, changed_at)
+                VALUES (1, ${held}, ${input.actor}, ${input.reason}, ${now})
+                ON CONFLICT (hold_id) DO UPDATE SET
+                  held = excluded.held,
+                  actor = excluded.actor,
+                  reason = excluded.reason,
+                  changed_at = excluded.changed_at
+              `;
+              yield* sql`
+                INSERT INTO orchestration_v2_hub_hold_history (action, actor, reason, changed_at)
+                VALUES (${action}, ${input.actor}, ${input.reason}, ${now})
+              `;
+              return yield* readRow;
+            }),
+          )
+          .pipe(Effect.mapError((cause) => new HubHoldError({ operation: action, cause })));
+
+      const counts = sql<{
+          readonly queued: number;
+          readonly held: number;
+          readonly in_flight: number;
+          readonly outbox_pending: number;
+          readonly outbox_running: number;
+          readonly held_effects: number;
+        }>`
+          SELECT
+            (SELECT COUNT(*) FROM orchestration_v2_projection_runs
+              WHERE status = 'queued' AND json_extract(payload_json, '$.queueHeld') IS NOT 1)
+              AS queued,
+            (SELECT COUNT(*) FROM orchestration_v2_projection_runs
+              WHERE status = 'queued' AND json_extract(payload_json, '$.queueHeld') IS 1) AS held,
+            (SELECT COUNT(*) FROM orchestration_v2_projection_runs
+              WHERE status IN ('preparing', 'starting', 'running', 'waiting')) AS in_flight,
+            (SELECT COUNT(*) FROM orchestration_v2_effect_outbox WHERE status = 'pending')
+              AS outbox_pending,
+            (SELECT COUNT(*) FROM orchestration_v2_effect_outbox WHERE status = 'running')
+              AS outbox_running,
+            (SELECT COUNT(*) FROM orchestration_v2_effect_outbox
+              WHERE status = 'pending' AND effect_type IN ${sql.in(EffectOutbox.HUB_HOLDABLE_EFFECT_TYPES)})
+              AS held_effects
+        `.pipe(
+          Effect.map((rows) => {
+            const row = rows[0];
+            return {
+              queued: row?.queued ?? 0,
+              held: row?.held ?? 0,
+              inFlight: row?.in_flight ?? 0,
+              outboxPending: row?.outbox_pending ?? 0,
+              outboxRunning: row?.outbox_running ?? 0,
+              heldEffects: row?.held_effects ?? 0,
+            };
+          }),
+          Effect.mapError((cause) => new HubHoldError({ operation: "counts", cause })),
+        );
+
+      const inventory = Effect.gen(function* () {
+        const current = yield* settings.getSettings.pipe(
+          Effect.mapError((cause) => new HubHoldError({ operation: "settings", cause })),
+        );
+        const projectOverridesEnabled = (
+          Object.keys(current.projectSettingsOverrides) as Array<ProjectId>
+        ).filter(
+          (projectId) =>
+            resolveProjectSettings(current, projectId).settings.continueThreadsAfterServerUpdate ===
+            true,
+        );
+        return {
+          runtime,
+          hold: yield* readRow.pipe(
+            Effect.mapError((cause) => new HubHoldError({ operation: "read", cause })),
+          ),
+          counts: yield* counts,
+          continueThreadsAfterServerUpdate: {
+            global: current.continueThreadsAfterServerUpdate,
+            projectOverridesEnabled,
+          },
+          readAt: DateTime.formatIso(yield* DateTime.now),
+        } satisfies HubDispatchInventory;
+      });
+
+      return HubHoldV2.of({
+        inventory,
+        counts,
+        read: readRow.pipe(Effect.mapError((cause) => new HubHoldError({ operation: "read", cause }))),
+        isHeld: readHubHeld(sql).pipe(
+          Effect.mapError((cause) => new HubHoldError({ operation: "read", cause })),
+        ),
+        set: (input) => write("set", input),
+        // Held effects are durable pending rows; waking the workers is all a
+        // clear needs to deliver each of them exactly once.
+        clear: (input) =>
+          write("clear", input).pipe(Effect.tap(() => outbox.notifyAvailable(64))),
+      });
+    }),
+  );
diff --git a/apps/server/src/orchestration-v2/LegacyDispatch.ts b/apps/server/src/orchestration-v2/LegacyDispatch.ts
new file mode 100644
index 000000000..ca281243c
--- /dev/null
+++ b/apps/server/src/orchestration-v2/LegacyDispatch.ts
@@ -0,0 +1,191 @@
+import {
+  CommandId,
+  type LegacyDispatchCommand,
+  type OrchestrationV2Command,
+  ProviderSessionId,
+  RunId,
+  type ThreadId,
+} from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as SqlClient from "effect/sql/SqlClient";
+
+/**
+ * Translates a 0.0.x `POST /api/orchestration/dispatch` command into the V2
+ * commands that do the same work. Operator tools keep their request shape;
+ * every translated command takes the normal V2 path, hub hold included.
+ *
+ * Per-turn runtime and interaction modes become thread-level mode commands,
+ * sent only when they differ from the thread's current modes. A command with
+ * nothing left to do translates to no commands.
+ */
+export const translateLegacyDispatch = Effect.fn("LegacyDispatch.translate")(function* (
+  command: LegacyDispatchCommand,
+) {
+  const sql = yield* SqlClient.SqlClient;
+  const derived = (suffix: string) => CommandId.make(`${command.commandId}:${suffix}`);
+
+  const activeRunIds = (threadId: ThreadId) =>
+    sql<{ readonly run_id: string }>`
+      SELECT run_id FROM orchestration_v2_projection_runs
+      WHERE thread_id = ${threadId} AND status IN ('preparing', 'starting', 'running', 'waiting')
+      ORDER BY ordinal DESC
+    `.pipe(Effect.map((rows) => rows.map((row) => RunId.make(row.run_id))));
+
+  switch (command.type) {
+    case "thread.turn.start": {
+      const modes = yield* sql<{
+        readonly runtime_mode: string;
+        readonly interaction_mode: string;
+      }>`
+        SELECT runtime_mode, interaction_mode FROM orchestration_v2_projection_threads
+        WHERE thread_id = ${command.threadId}
+      `;
+      const current = modes[0];
+      const commands: Array<OrchestrationV2Command> = [];
+      if (current !== undefined && current.runtime_mode !== command.runtimeMode) {
+        commands.push({
+          type: "thread.runtime-mode.set",
+          commandId: derived("runtime-mode"),
+          threadId: command.threadId,
+          runtimeMode: command.runtimeMode,
+        });
+      }
+      if (current !== undefined && current.interaction_mode !== command.interactionMode) {
+        commands.push({
+          type: "thread.interaction-mode.set",
+          commandId: derived("interaction-mode"),
+          threadId: command.threadId,
+          interactionMode: command.interactionMode,
+        });
+      }
+      // 0.0.x queued a turn behind the running one; it never steered.
+      commands.push({
+        type: "message.dispatch",
+        createdBy: "user",
+        creationSource: "web",
+        commandId: command.commandId,
+        threadId: command.threadId,
+        messageId: command.message.messageId,
+        text: command.message.text,
+        attachments: command.message.attachments,
+        ...(command.message.context === undefined ? {} : { context: command.message.context }),
+        ...(command.titleSeed === undefined ? {} : { titleSeed: command.titleSeed }),
+        ...(command.modelSelection === undefined
+          ? {}
+          : { modelSelection: command.modelSelection }),
+        dispatchMode: { type: "queue_after_active" },
+      });
+      return commands;
+    }
+    case "thread.create":
+      return [
+        {
+          type: "thread.create",
+          createdBy: "user",
+          creationSource: "web",
+          commandId: command.commandId,
+          threadId: command.threadId,
+          projectId: command.projectId,
+          title: command.title,
+          modelSelection: command.modelSelection,
+          runtimeMode: command.runtimeMode,
+          interactionMode: command.interactionMode,
+          branch: command.branch,
+          worktreePath: command.worktreePath,
+        },
+      ] satisfies Array<OrchestrationV2Command>;
+    case "thread.turn.interrupt":
+      return (yield* activeRunIds(command.threadId)).map(
+        (runId, index): OrchestrationV2Command => ({
+          type: "run.interrupt",
+          commandId: index === 0 ? command.commandId : derived(`interrupt:${runId}`),
+          threadId: command.threadId,
+          runId,
+        }),
+      );
+    case "thread.session.stop": {
+      // 0.0.x stopped the provider session: the running turn and its process.
+      const runs = yield* activeRunIds(command.threadId);
+      if (command.onlyIfSettled === true) {
+        const engaged = yield* sql<{ readonly engaged: number }>`
+          SELECT
+            (
+              json_extract(payload_json, '$.settledAt') IS NULL
+              AND json_extract(payload_json, '$.settledOverride') IS NOT 'settled'
+            )
+            OR EXISTS (
+              SELECT 1 FROM orchestration_v2_projection_runs
+              WHERE thread_id = ${command.threadId}
+                AND status IN ('queued', 'preparing', 'starting', 'running', 'waiting')
+            ) AS engaged
+          FROM orchestration_v2_projection_threads WHERE thread_id = ${command.threadId}
+        `;
+        if (engaged[0]?.engaged !== 0) return [];
+      }
+      const sessions = yield* sql<{ readonly provider_session_id: string }>`
+        SELECT provider_session_id FROM orchestration_v2_projection_provider_sessions
+        WHERE thread_id = ${command.threadId} AND status NOT IN ('stopped', 'error')
+      `;
+      return [
+        ...(runs.length > 0
+          ? [
+              {
+                type: "thread.stop",
+                commandId: command.commandId,
+                threadId: command.threadId,
+                reason: "Session stop requested through the 0.0.x dispatch endpoint.",
+              } satisfies OrchestrationV2Command,
+            ]
+          : []),
+        ...sessions.map(
+          (session, index): OrchestrationV2Command => ({
+            type: "provider-session.detach",
+            commandId:
+              runs.length === 0 && index === 0
+                ? command.commandId
+                : derived(`detach:${session.provider_session_id}`),
+            threadId: command.threadId,
+            providerSessionId: ProviderSessionId.make(session.provider_session_id),
+            reason: "Session stop requested through the 0.0.x dispatch endpoint.",
+          }),
+        ),
+      ];
+    }
+    case "thread.archive":
+    case "thread.unarchive":
+    case "thread.settle":
+      return [
+        { type: command.type, commandId: command.commandId, threadId: command.threadId },
+      ] satisfies Array<OrchestrationV2Command>;
+    case "thread.meta.update": {
+      const commands: Array<OrchestrationV2Command> = [];
+      if (command.modelSelection !== undefined) {
+        commands.push({
+          type: "thread.model-selection.set",
+          commandId: derived("model-selection"),
+          threadId: command.threadId,
+          modelSelection: command.modelSelection,
+        });
+      }
+      if (
+        command.title !== undefined ||
+        command.regenerateTitle !== undefined ||
+        command.branch !== undefined ||
+        command.worktreePath !== undefined
+      ) {
+        commands.push({
+          type: "thread.metadata.update",
+          commandId: command.commandId,
+          threadId: command.threadId,
+          ...(command.title === undefined ? {} : { title: command.title }),
+          ...(command.regenerateTitle === undefined
+            ? {}
+            : { regenerateTitle: command.regenerateTitle }),
+          ...(command.branch === undefined ? {} : { branch: command.branch }),
+          ...(command.worktreePath === undefined ? {} : { worktreePath: command.worktreePath }),
+        });
+      }
+      return commands;
+    }
+  }
+});
diff --git a/apps/server/src/orchestration-v2/RuntimeIdentity.ts b/apps/server/src/orchestration-v2/RuntimeIdentity.ts
new file mode 100644
index 000000000..140a568cd
--- /dev/null
+++ b/apps/server/src/orchestration-v2/RuntimeIdentity.ts
@@ -0,0 +1,38 @@
+import type { HubDispatchRuntimeIdentity } from "@t3tools/contracts";
+import * as Effect from "effect/Effect";
+import * as Hex from "effect/encoding/Hex";
+import * as FileSystem from "effect/FileSystem";
+import * as Path from "effect/Path";
+
+import packageJson from "../../package.json" with { type: "json" };
+
+/**
+ * Identity of the bundle this process loaded, captured once at boot. Hashing
+ * later would report replaced staging files instead of the running bytes.
+ */
+export const captureRuntimeIdentity: Effect.Effect<
+  HubDispatchRuntimeIdentity,
+  never,
+  FileSystem.FileSystem | Path.Path
+> = Effect.gen(function* () {
+  const fs = yield* FileSystem.FileSystem;
+  const path = yield* Path.Path;
+  const entry = process.argv[1];
+  if (entry === undefined || path.extname(entry) !== ".mjs") {
+    return { version: packageJson.version, entryPath: null, bundleSha256: null };
+  }
+  const entryPath = yield* fs.realPath(entry);
+  const bytes = yield* fs.readFile(entryPath);
+  const digest = yield* Effect.promise(() => crypto.subtle.digest("SHA-256", bytes));
+  return {
+    version: packageJson.version,
+    entryPath,
+    bundleSha256: Hex.encode(new Uint8Array(digest)),
+  };
+}).pipe(
+  Effect.orElseSucceed(() => ({
+    version: packageJson.version,
+    entryPath: null,
+    bundleSha256: null,
+  })),
+);
