index 000000000..4bcf39c27
--- /dev/null
+++ b/packages/contracts/src/hubDispatch.ts
@@ -0,0 +1,161 @@
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+
+import {
+  CommandId,
+  IsoDateTime,
+  MessageId,
+  NonNegativeInt,
+  ProjectId,
+  ThreadId,
+  TrimmedNonEmptyString,
+} from "./baseSchemas.ts";
+import { ChatAttachment } from "./chatAttachment.ts";
+import { OrchestrationMessageContext } from "./composerContext.ts";
+import { ModelSelection } from "./modelSelection.ts";
+import {
+  DEFAULT_PROVIDER_INTERACTION_MODE,
+  DEFAULT_RUNTIME_MODE,
+  ProviderInteractionMode,
+  RuntimeMode,
+} from "./providerPolicy.ts";
+
+/**
+ * Hub-wide dispatch hold. While held every message is still accepted and
+ * committed; nothing new reaches a provider until the hold clears.
+ */
+export const HubDispatchHoldState = Schema.Struct({
+  held: Schema.Boolean,
+  actor: Schema.NullOr(Schema.String),
+  reason: Schema.NullOr(Schema.String),
+  changedAt: Schema.NullOr(Schema.String),
+});
+export type HubDispatchHoldState = typeof HubDispatchHoldState.Type;
+
+export const HubDispatchHoldInput = Schema.Struct({
+  reason: TrimmedNonEmptyString,
+});
+export type HubDispatchHoldInput = typeof HubDispatchHoldInput.Type;
+
+export const HubDispatchInventoryCounts = Schema.Struct({
+  /** Queued runs that will start on their own once their thread is free. */
+  queued: NonNegativeInt,
+  /** Queued runs that wait for an explicit queue resume (after a restart, stop or failure). */
+  held: NonNegativeInt,
+  /** Runs that are preparing, starting, running or waiting. */
+  inFlight: NonNegativeInt,
+  outboxPending: NonNegativeInt,
+  outboxRunning: NonNegativeInt,
+  /** Pending effects that hand input to a provider; kept pending while the hub is held. */
+  heldEffects: NonNegativeInt,
+});
+export type HubDispatchInventoryCounts = typeof HubDispatchInventoryCounts.Type;
+
+export const HubDispatchRuntimeIdentity = Schema.Struct({
+  version: Schema.String,
+  entryPath: Schema.NullOr(Schema.String),
+  bundleSha256: Schema.NullOr(Schema.String),
+});
+export type HubDispatchRuntimeIdentity = typeof HubDispatchRuntimeIdentity.Type;
+
+export const HubDispatchInventory = Schema.Struct({
+  runtime: HubDispatchRuntimeIdentity,
+  hold: HubDispatchHoldState,
+  counts: HubDispatchInventoryCounts,
+  continueThreadsAfterServerUpdate: Schema.Struct({
+    global: Schema.Boolean,
+    /** Projects whose override turns continuation on, whatever the global value. */
+    projectOverridesEnabled: Schema.Array(ProjectId),
+  }),
+  readAt: Schema.String,
+});
+export type HubDispatchInventory = typeof HubDispatchInventory.Type;
+
+/**
+ * The 0.0.x `POST /api/orchestration/dispatch` command shapes that operator
+ * tools still send. Each one is translated onto the V2 dispatch path.
+ */
+export const LegacyThreadTurnStartCommand = Schema.Struct({
+  type: Schema.Literal("thread.turn.start"),
+  commandId: CommandId,
+  threadId: ThreadId,
+  message: Schema.Struct({
+    messageId: MessageId,
+    role: Schema.Literal("user"),
+    text: Schema.String,
+    attachments: Schema.Array(ChatAttachment),
+    context: Schema.optional(OrchestrationMessageContext),
+  }),
+  modelSelection: Schema.optional(ModelSelection),
+  titleSeed: Schema.optional(TrimmedNonEmptyString),
+  runtimeMode: RuntimeMode.pipe(Schema.withDecodingDefault(Effect.succeed(DEFAULT_RUNTIME_MODE))),
+  interactionMode: ProviderInteractionMode.pipe(
+    Schema.withDecodingDefault(Effect.succeed(DEFAULT_PROVIDER_INTERACTION_MODE)),
+  ),
+  createdAt: IsoDateTime,
+});
+export type LegacyThreadTurnStartCommand = typeof LegacyThreadTurnStartCommand.Type;
+
+export const LegacyDispatchCommand = Schema.Union([
+  LegacyThreadTurnStartCommand,
+  Schema.Struct({
+    type: Schema.Literal("thread.create"),
+    commandId: CommandId,
+    threadId: ThreadId,
+    projectId: ProjectId,
+    title: TrimmedNonEmptyString,
+    modelSelection: ModelSelection,
+    runtimeMode: RuntimeMode,
+    interactionMode: ProviderInteractionMode.pipe(
+      Schema.withDecodingDefault(Effect.succeed(DEFAULT_PROVIDER_INTERACTION_MODE)),
+    ),
+    branch: Schema.NullOr(TrimmedNonEmptyString),
+    worktreePath: Schema.NullOr(TrimmedNonEmptyString),
+    createdAt: IsoDateTime,
+  }),
+  Schema.Struct({
+    type: Schema.Literal("thread.turn.interrupt"),
+    commandId: CommandId,
+    threadId: ThreadId,
+    turnId: Schema.optional(TrimmedNonEmptyString),
+    createdAt: IsoDateTime,
+  }),
+  Schema.Struct({
+    type: Schema.Literal("thread.session.stop"),
+    commandId: CommandId,
+    threadId: ThreadId,
+    createdAt: IsoDateTime,
+    onlyIfSettled: Schema.optional(Schema.Boolean),
+  }),
+  Schema.Struct({
+    type: Schema.Literal("thread.archive"),
+    commandId: CommandId,
+    threadId: ThreadId,
+  }),
+  Schema.Struct({
+    type: Schema.Literal("thread.unarchive"),
+    commandId: CommandId,
+    threadId: ThreadId,
+  }),
+  Schema.Struct({
+    type: Schema.Literal("thread.settle"),
+    commandId: CommandId,
+    threadId: ThreadId,
+  }),
+  Schema.Struct({
+    type: Schema.Literal("thread.meta.update"),
+    commandId: CommandId,
+    threadId: ThreadId,
+    title: Schema.optional(TrimmedNonEmptyString),
+    regenerateTitle: Schema.optional(Schema.Literal(true)),
+    modelSelection: Schema.optional(ModelSelection),
+    branch: Schema.optional(Schema.NullOr(TrimmedNonEmptyString)),
+    worktreePath: Schema.optional(Schema.NullOr(TrimmedNonEmptyString)),
+  }),
+]);
+export type LegacyDispatchCommand = typeof LegacyDispatchCommand.Type;
+
+export const LegacyDispatchResult = Schema.Struct({
+  sequence: NonNegativeInt,
+});
+export type LegacyDispatchResult = typeof LegacyDispatchResult.Type;
