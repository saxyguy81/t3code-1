+import * as Effect from "effect/Effect";
+import * as SqlClient from "effect/sql/SqlClient";
+
+export default Effect.gen(function* () {
+  const sql = yield* SqlClient.SqlClient;
+
+  // One server-wide row. The effect outbox reads it inside each claim, so a
+  // committed hold and a claim cannot interleave.
+  yield* sql`
+    CREATE TABLE IF NOT EXISTS orchestration_v2_hub_hold (
+      hold_id INTEGER PRIMARY KEY CHECK (hold_id = 1),
+      held INTEGER NOT NULL CHECK (held IN (0, 1)),
+      actor TEXT NOT NULL,
+      reason TEXT NOT NULL,
+      changed_at TEXT NOT NULL
+    )
+  `;
+  yield* sql`
+    CREATE TABLE IF NOT EXISTS orchestration_v2_hub_hold_history (
+      sequence INTEGER PRIMARY KEY AUTOINCREMENT,
+      action TEXT NOT NULL CHECK (action IN ('set', 'clear')),
+      actor TEXT NOT NULL,
+      reason TEXT NOT NULL,
+      changed_at TEXT NOT NULL
+    )
+  `;
+});
