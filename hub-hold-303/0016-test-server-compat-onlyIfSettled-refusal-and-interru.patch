+
+it.effect("refuses an onlyIfSettled session.stop instead of racing its check", () =>
+  Effect.gen(function* () {
+    yield* seedThread({ threadId: "thread:settled", payload: { settledOverride: "settled" } });
+    yield* seedSession("thread:settled", "session:live", "ready");
+    const failure = yield* translateLegacyDispatch(stop("thread:settled", true)).pipe(Effect.flip);
+    assert.equal(failure._tag, "LegacyDispatchUnsupportedError");
+  }).pipe(Effect.provide(layerTest())),
+);
+
+it.effect("interrupts nothing on a retry once the command already interrupted a run", () =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient.SqlClient;
+    yield* seedThread({ threadId: "thread:retry" });
+    yield* seedRun("thread:retry", "run:first", 1, "completed");
+    yield* seedRun("thread:retry", "run:second", 2, "running");
+    yield* sql`
+      INSERT INTO orchestration_v2_command_receipts (
+        command_id, thread_id, command_type, accepted_at, result_sequence, status
+      )
+      VALUES (
+        ${"command:int:interrupt:run:first"}, ${"thread:retry"}, ${"run.interrupt"},
+        ${timestamp}, ${1}, ${"accepted"}
+      )
+    `;
+    const interrupt = decodeCommand({
+      type: "thread.turn.interrupt",
+      commandId: "command:int",
+      threadId: "thread:retry",
+      createdAt: timestamp,
+    });
+    assert.deepEqual(yield* translateLegacyDispatch(interrupt), []);
+    yield* seedSession("thread:retry", "session:live", "ready");
+    assert.deepEqual(
+      (yield* translateLegacyDispatch(stop("thread:retry"))).map((command) => command.type),
+      ["run.interrupt", "provider-session.detach"],
+    );
+  }).pipe(Effect.provide(layerTest())),
+);
