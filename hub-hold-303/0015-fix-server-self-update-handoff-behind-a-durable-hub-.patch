+const idleHold = { held: false, actor: null, reason: null, changedAt: null };
+
 const hubHoldInventory = (counts: Partial<typeof quiescentCounts>) =>
   Effect.succeed({
     runtime: { version: "1.0.0", entryPath: null, bundleSha256: null },
@@ -147,6 +149,9 @@ const makeHarness = Effect.fn("test.make_self_update_harness")(function* (
