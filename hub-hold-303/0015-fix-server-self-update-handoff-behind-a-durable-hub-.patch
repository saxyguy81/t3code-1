+          `(queued ${queued}, in flight ${inFlight}, outbox pending ${outboxPending}, claimed ${outboxRunning})`,
         );
         expect(order).not.toContain("accept");
       }),
@@ -524,11 +529,64 @@ it.layer(NodeServices.layer)("server self update", (it) => {
   it.effect("proceeds to the launcher when no provider work is pending", () =>
     Effect.gen(function* () {
       const { selfUpdate, order } = yield* makeHarness({
-        hubHold: { inventory: hubHoldInventory({ held: 5, outboxPending: 2 }) },
+        hubHold: { inventory: hubHoldInventory({ held: 5 }) },
       });
-      // Idle queued-resume runs and ordinary pending effects do not block.
+      // Idle queued runs waiting for an explicit resume do not block.
       expect((yield* selfUpdate.update({ targetVersion: "1.1.0" })).updateId).toBe("launcher-id");
       expect(order).toContain("accept");
     }),
   );
+
+  it.effect("sets the hold before counting and keeps it across a handoff", () =>
+    Effect.gen(function* () {
+      const calls: Array<string> = [];
+      const { selfUpdate } = yield* makeHarness({
+        hubHold: {
+          set: (input) =>
+            Effect.sync(() => calls.push(`set:${input.actor}`)).pipe(
+              Effect.as({ ...idleHold, held: true }),
+            ),
+          clear: () => Effect.sync(() => calls.push("clear")).pipe(Effect.as(idleHold)),
+          inventory: Effect.sync(() => calls.push("count")).pipe(
+            Effect.andThen(hubHoldInventory({})),
+          ),
+        },
+      });
+      yield* selfUpdate.update({ targetVersion: "1.1.0" });
+      expect(calls).toEqual(["set:self-update", "count"]);
+    }),
+  );
+
+  it.effect("clears a hold it set when the update is refused", () =>
+    Effect.gen(function* () {
+      const calls: Array<string> = [];
+      const { selfUpdate } = yield* makeHarness({
+        hubHold: {
+          set: () =>
+            Effect.sync(() => calls.push("set")).pipe(Effect.as({ ...idleHold, held: true })),
+          clear: () => Effect.sync(() => calls.push("clear")).pipe(Effect.as(idleHold)),
+          inventory: hubHoldInventory({ inFlight: 1 }),
+        },
+      });
+      yield* selfUpdate.update({ targetVersion: "1.1.0" }).pipe(Effect.flip);
+      expect(calls).toEqual(["set", "clear"]);
+    }),
+  );
+
+  it.effect("leaves an operator's hold alone when the update is refused", () =>
+    Effect.gen(function* () {
+      const calls: Array<string> = [];
+      const { selfUpdate } = yield* makeHarness({
+        hubHold: {
+          read: Effect.succeed({ ...idleHold, held: true, actor: "operator" }),
+          set: () =>
+            Effect.sync(() => calls.push("set")).pipe(Effect.as({ ...idleHold, held: true })),
+          clear: () => Effect.sync(() => calls.push("clear")).pipe(Effect.as(idleHold)),
+          inventory: hubHoldInventory({ queued: 1 }),
+        },
+      });
+      yield* selfUpdate.update({ targetVersion: "1.1.0" }).pipe(Effect.flip);
+      expect(calls).toEqual([]);
+    }),
+  );
 });
diff --git a/apps/server/src/cloud/selfUpdate.ts b/apps/server/src/cloud/selfUpdate.ts
index c2037adb7..d752f32dd 100644
--- a/apps/server/src/cloud/selfUpdate.ts
+++ b/apps/server/src/cloud/selfUpdate.ts
@@ -188,25 +188,55 @@ export const make = Effect.fn("cloud.server_self_update.make")(function* () {
   const inFlight = yield* Ref.make(false);
   const hubHold = yield* Effect.serviceOption(HubHold.HubHoldV2);
   // 0.1.0 has no setting that turns self-update off, so every update path
-  // fails closed unless the dispatch inventory is readable and shows no
-  // provider work that a restart would cut: nothing queued to start, in
-  // flight, claimed, or waiting on the hub hold.
-  const requireQuiescentHub = Effect.gen(function* () {
-    if (Option.isNone(hubHold)) {
-      return yield* failWith("Server updates are blocked: the dispatch inventory is unavailable.");
-    }
-    const inventory = yield* hubHold.value.inventory.pipe(
-      Effect.mapError((cause) =>
-        failWith("Server updates are blocked: the dispatch inventory could not be read.", cause),
-      ),
-    );
-    const { queued, inFlight: running, outboxRunning, heldEffects } = inventory.counts;
-    if (queued + running + outboxRunning + heldEffects > 0) {
-      return yield* failWith(
-        `Server updates are blocked while provider work is pending (queued ${queued}, in flight ${running}, claimed ${outboxRunning}, held ${heldEffects}).`,
+  // goes through this barrier and fails closed. It sets the hub hold before
+  // counting, so a message accepted after the count stays durable and cannot
+  // reach a provider before the restart. The handoff runs only when nothing is
+  // queued, in flight, claimed or pending in the outbox (interrupts and
+  // approval answers included). On refusal or a failed handoff the barrier
+  // clears a hold it set; after a handoff the hold stays set across the
+  // restart until an operator clears it.
+  const withUpdateBarrier = <A, E, R>(handoff: Effect.Effect<A, E, R>) =>
+    Effect.gen(function* () {
+      if (Option.isNone(hubHold)) {
+        return yield* failWith(
+          "Server updates are blocked: the dispatch inventory is unavailable.",
+        );
+      }
+      const hold = hubHold.value;
+      const before = yield* hold.read.pipe(
+        Effect.mapError((cause) =>
+          failWith("Server updates are blocked: the hub hold could not be read.", cause),
+        ),
       );
-    }
-  });
+      if (!before.held) {
+        yield* hold
+          .set({ actor: "self-update", reason: "Holding dispatch for a server update handoff." })
+          .pipe(
+            Effect.mapError((cause) =>
+              failWith("Server updates are blocked: the hub hold could not be set.", cause),
+            ),
+          );
+      }
+      const release = before.held
+        ? Effect.void
+        : hold
+            .clear({ actor: "self-update", reason: "The server update did not hand off." })
+            .pipe(Effect.ignore);
+      const inventory = yield* hold.inventory.pipe(
+        Effect.mapError((cause) =>
+          failWith("Server updates are blocked: the dispatch inventory could not be read.", cause),
+        ),
+        Effect.tapError(() => release),
+      );
+      const { queued, inFlight: running, outboxPending, outboxRunning } = inventory.counts;
+      if (queued + running + outboxPending + outboxRunning > 0) {
+        yield* release;
+        return yield* failWith(
+          `Server updates are blocked while provider work is pending (queued ${queued}, in flight ${running}, outbox pending ${outboxPending}, claimed ${outboxRunning}).`,
+        );
+      }
+      return yield* handoff.pipe(Effect.onError(() => release));
+    });
 
   const capability: ServerSelfUpdateCapability | null =
     serverConfig.mode === "desktop" ? "desktop-managed" : launcher.managed ? "boot-service" : null;
@@ -223,8 +253,7 @@ export const make = Effect.fn("cloud.server_self_update.make")(function* () {
       // update feed decides what it downloads, and the result carries what
