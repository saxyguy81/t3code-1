@@ -479,7 +484,7 @@ it.layer(NodeServices.layer)("server self update", (it) => {
     ["queued", { queued: 2 }],
     ["in flight", { inFlight: 1 }],
     ["claimed", { outboxRunning: 3 }],
-    ["held", { heldEffects: 4 }],
+    ["outbox pending", { outboxPending: 4 }],
   ] as const) {
     it.effect(`refuses an update while ${label} provider work is pending`, () =>
       Effect.gen(function* () {
@@ -493,11 +498,11 @@ it.layer(NodeServices.layer)("server self update", (it) => {
         const {
           queued = 0,
           inFlight = 0,
